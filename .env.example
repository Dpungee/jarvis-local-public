# Copy this file to .env only if you want to override defaults.
# JARVIS_WORKSPACE=C:\path\to\jarvis-workspace
# JARVIS_DATA=C:\path\to\jarvis-data
# Optional existing Obsidian vault directory. Leave empty to disable the mirror.
# JARVIS_VAULT=C:\path\to\Obsidian\Jarvis
# JARVIS_SOUL=C:\path\to\SOUL.md
# auto routes each task; it can also be fast, reasoning, coding, deep, a local model,
# or an explicit openai:<model> / anthropic:<model> / codex-cli:<model> /
# claude-cli:<model> reference. The first-run provider chooser assigns the fast,
# reasoning, coding, and deep Codex models automatically; explicit overrides are advanced.
JARVIS_MODEL=auto
# Optional operator-controlled behavior file. JARVIS cannot edit it through its tools.
# JARVIS_CONSTITUTION=C:\path\to\CONSTITUTION.md
JARVIS_FAST_MODEL=qwen3.5:9b
JARVIS_REASONING_MODEL=gpt-oss:20b
JARVIS_CODING_MODEL=qwen3-coder:30b
# Manual-only high-quality local profile. Automatic routing never selects it.
JARVIS_DEEP_MODEL=qwen3-coder:30b
# Recurring learning uses fast by default so background work does not load a 30B model.
JARVIS_BACKGROUND_MODEL=fast
# Optional dedicated low-cost model for every recurring learning brief. When
# unset, deep learning briefs retain the reasoning profile.
# JARVIS_LEARNING_MODEL=openai:gpt-5.6-luna
# Loopback is required unless you explicitly trust a remote HTTPS endpoint.
JARVIS_OLLAMA_ENABLED=true
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_ALLOW_REMOTE=false
JARVIS_OLLAMA_HEALTH_TIMEOUT=5
JARVIS_OLLAMA_GENERATION_TIMEOUT=600
JARVIS_OLLAMA_MAX_OUTPUT_TOKENS=2048
JARVIS_OLLAMA_MAX_RESPONSE_BYTES=8388608
JARVIS_OLLAMA_MAX_RETRIES=2
# Deterministic exponential retry delay in seconds: 0.25, 0.5, ...
JARVIS_OLLAMA_RETRY_BACKOFF=0.25
# Keep a selected model resident, optionally pay its cold load at startup, and
# cap CPU inference threads. Leave NUM_THREAD unset to let Ollama choose.
JARVIS_OLLAMA_KEEP_ALIVE=30m
# Unload the manual large model immediately after its request.
JARVIS_OLLAMA_DEEP_KEEP_ALIVE=0
# JARVIS_OLLAMA_NUM_THREAD=8
JARVIS_OLLAMA_PRELOAD=false
# Some models spend the entire output budget in hidden reasoning. Disable this
# when measurements show that direct answers are more reliable for the selected model.
JARVIS_REASONING_THINKING=true

# Optional OpenAI and Anthropic providers use OPENAI_API_KEY and
# ANTHROPIC_API_KEY from the process/Windows environment. Cloud keys are
# deliberately not accepted in this plaintext project file. See README.md.
JARVIS_CLOUD_ENABLED=true
# Direct APIs are separately billed. The subscription wizard sets both false so
# a CLI outage cannot silently fail over to an ambient API key.
JARVIS_OPENAI_API_ENABLED=false
# Image generation/editing is separately billed and can remain enabled while
# OpenAI text API fallback stays disabled.
JARVIS_OPENAI_IMAGES_ENABLED=false
JARVIS_ANTHROPIC_API_ENABLED=false
# Optional: use an existing Codex CLI ChatGPT-subscription login through a
# bounded non-interactive backend. Codex tools and session persistence stay disabled.
JARVIS_CODEX_CLI_ENABLED=false
# Optional: use an existing Claude Code subscription login through a bounded,
# non-interactive backend. Claude Code tools and session persistence stay disabled.
JARVIS_CLAUDE_CLI_ENABLED=false
# Read-only isolated self-tests and explicit runtime/test source inspection. Never permits source writes.
JARVIS_SELF_INSPECT=disabled
JARVIS_SELF_REPAIR=disabled
JARVIS_INITIATIVE=disabled
JARVIS_INITIATIVE_QUIET_HOURS=
JARVIS_CLOUD_GENERATION_TIMEOUT=600
JARVIS_CLOUD_MAX_OUTPUT_TOKENS=8192
JARVIS_CLOUD_MAX_RESPONSE_BYTES=8388608
JARVIS_CLOUD_MAX_RETRIES=2
JARVIS_CLOUD_RETRY_BACKOFF=0.5
# Bound concurrent OpenAI agents so account rate limits and local tools remain controlled.
JARVIS_PRESENCE_MAX_AGENTS=3
JARVIS_WORKER_CONCURRENCY=3
# One operator request and every specialist it delegates share these durable limits.
JARVIS_MODEL_CALL_LIMIT_PER_REQUEST=48
JARVIS_PROMPT_TOKEN_LIMIT_PER_REQUEST=400000
JARVIS_COMPLETION_TOKEN_LIMIT_PER_REQUEST=40000
JARVIS_SPECIALIST_DELEGATION_LIMIT_PER_REQUEST=4
JARVIS_MAX_STEPS=20
# All profile contexts default to a fixed 16384 to avoid costly model reloads.
# JARVIS_CONTEXT_LENGTH=32768
JARVIS_FAST_CONTEXT_LENGTH=16384
JARVIS_REASONING_CONTEXT_LENGTH=16384
JARVIS_CODING_CONTEXT_LENGTH=16384
# Bound RAM/VRAM pressure when a 30B model spills layers to CPU.
JARVIS_DEEP_CONTEXT_LENGTH=4096
JARVIS_COMMAND_TIMEOUT=120

# disabled = no host process execution (safe default)
# trusted-host = run allowlisted local build/test programs with your full Windows account permissions
# trusted-host is NOT a sandbox; use it only with code and workspaces you trust.
JARVIS_EXECUTION_MODE=disabled
# host preserves the current contained Windows execution path. docker runs the
# same allowlisted commands in an ephemeral, networkless, resource-limited container.
# Docker mode fails closed when Docker Desktop/the daemon is unavailable.
JARVIS_EXECUTION_BACKEND=host
# trusted-desktop enables broad ordinary-file access under your user profile plus app launch.
# Credential stores, links, deletion, and system-wide mutation remain blocked.
JARVIS_COMPUTER_ACCESS=disabled
JARVIS_COMPUTER_ROOT=C:\Users\your-name

# External account tools are hidden unless explicitly enabled. Mutating or
# publishing actions still create exact one-shot approval requests.
JARVIS_EXTERNAL_ACCESS=disabled
# Drive defaults to its application-owned folder. Full account access is an
# explicit scope expansion and still keeps mutations approval-gated.
JARVIS_GOOGLE_DRIVE_ACCESS=app_files

# Private-LAN inventory is opt-in. "private-lan" permits a bounded discovery
# pass only across directly connected RFC1918 IPv4 ranges. It reads the Windows
# neighbor cache and sends at most one ICMP echo per bounded candidate; it never
# scans ports, services, credentials, packets, public IPs, or routed networks.
JARVIS_NETWORK_ACCESS=disabled
# Background checks are opt-in and only run for explicitly paired networks.
# They use the same bounded, no-port-scan discovery and stop with Presence.
JARVIS_NETWORK_MONITOR_ENABLED=0
JARVIS_NETWORK_MONITOR_INTERVAL_SECONDS=300
# alert-only creates durable explanatory incidents. safe-readonly may also run
# installed, allowlisted passive diagnostics and records receipts in the popup.
# It never enables active probing, blocking, quarantine, or firewall changes.
JARVIS_NETWORK_DEFENSE_MODE=disabled
# Show durable, explanatory network-security incident popups in Presence.
JARVIS_NETWORK_INCIDENT_POPUPS_ENABLED=0

# Windows-confirmed paired Bluetooth endpoints only; no nearby RF scan or control.
JARVIS_BLUETOOTH_ACCESS=disabled
JARVIS_BLUETOOTH_MONITOR_ENABLED=0
JARVIS_BLUETOOTH_MONITOR_INTERVAL_SECONDS=60

# Optional local smart-home control through a paired Home Assistant instance.
# Use an exact private IP origin and explicitly allowlist remote.* entities.
# The token is never returned by Jarvis. Every device-changing action still
# requires exact operator approval and is verified by a state readback.
JARVIS_HOME_ASSISTANT_ACCESS=disabled
# "netgear-readonly" reads only router-sourced device trackers and bounded
# NETGEAR diagnostic sensors. Link rate is labeled as capacity, never usage.
JARVIS_HOME_ASSISTANT_NETWORK_ACCESS=disabled
JARVIS_HOME_ASSISTANT_URL=
JARVIS_HOME_ASSISTANT_TOKEN=
JARVIS_HOME_ASSISTANT_ENTITIES=

# Semantic memory can send redacted memory text to the selected cloud embedding
# provider. It is off by default and requires trusted external access as well.
JARVIS_MEMORY_AUTO_IMPROVE=true
# Cross-domain procedural transfer starts in observe mode: it records exact,
# provenance-bound outcomes but cannot alter a prompt. In this release,
# "trial" enables only an explicitly started, bounded, pinned causal trial.
# "advise" still requires a valid pinned causal attestation and a separate
# explicit operator promotion; setting the mode alone grants no authority.
JARVIS_STRATEGY_TRANSFER=observe
JARVIS_MEMORY_EMBEDDINGS=disabled
JARVIS_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
JARVIS_MEMORY_EMBEDDING_DIMENSIONS=512
# Structured facts learn a restart-safe volatility clock. Shadow records the
# effective confidence without changing prompts; enforce treats stale claims as
# uncertain. Protected operator preferences/identity/safety never decay.
JARVIS_MEMORY_CLAIM_CLOCK=shadow
JARVIS_MEMORY_CLAIM_STALE_THRESHOLD=0.70

# Proactive work is opt-in and selects only explicitly approved subjects.
JARVIS_PROACTIVE_ENABLED=false
JARVIS_PROACTIVE_IDLE_SECONDS=300
JARVIS_PROACTIVE_MAX_TASK_SECONDS=1800
JARVIS_PROACTIVE_DAILY_TASK_LIMIT=4
JARVIS_DAILY_TOOL_LIMIT=500
JARVIS_APPROVAL_TTL_HOURS=24

# The Presence web interface listens only on this computer. For remote access,
# proxy it through Tailscale Serve instead of exposing a LAN/internet socket.
JARVIS_PRESENCE_HOST=127.0.0.1
JARVIS_PRESENCE_PORT=8787
# Keep disabled for local-only use. "paired" still requires an authenticated
# HTTPS reverse proxy and an exact trusted hostname below.
JARVIS_PRESENCE_REMOTE_ACCESS=disabled
# Exact proxy hostnames accepted in Host/Origin headers (no wildcards). Leave
# empty for local-only use; set the Tailscale Serve hostname when using it.
JARVIS_PRESENCE_TRUSTED_HOSTS=

# Screen Companion is opt-in. "observe" keeps only foreground app/title metadata
# in process memory. "suggest" can inspect the active window for advice.
# "collaborate" can run operator-authored per-app routines, while retaining all
# normal tool, approval, redaction, and foreground-window checks.
JARVIS_SCREEN_COMPANION=disabled
# Shows a small always-on-top Windows status/control indicator while Presence runs.
JARVIS_SCREEN_COMPANION_INDICATOR=1
JARVIS_SCREEN_COMPANION_POLL_SECONDS=2
JARVIS_SCREEN_COMPANION_STABLE_SECONDS=8
JARVIS_SCREEN_COMPANION_AUTO_COOLDOWN_SECONDS=900

# Public Presence is a separate, hostile-input security domain. The foundation
# ships disabled and disconnected: setting this flag alone never connects an
# account, starts a listener, or grants publishing authority.
JARVIS_PUBLIC_PRESENCE_ENABLED=false

# Optional private, single-owner phone bridge. Telegram is implemented first;
# the token is a secret and replies from IDs outside the allowlist are dropped.
JARVIS_GATEWAY_CHANNEL=
# JARVIS_GATEWAY_TOKEN=
JARVIS_GATEWAY_ALLOWED_IDS=

# Optional: official Ollama web search (https://ollama.com/settings/keys)
# OLLAMA_API_KEY=

# autonomous = allow workspace file writes and durable memory
# readonly = disable workspace writes, processes, and durable memory writes
JARVIS_AUTONOMY=autonomous
